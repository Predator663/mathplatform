# Copy this to .env for local dev, set these as Render env vars for production

SECRET_KEY=django-insecure-change-me-in-production-at-least-50-chars-long
DEBUG=False
ALLOWED_HOSTS=your-backend.onrender.com,localhost
DATABASE_URL=postgres://user:pass@host:5432/dbname
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
CORS_ALLOW_ALL_ORIGINS=False

# Email notifications — free SMTP relay, no paid service required. Leave
# EMAIL_HOST blank to just print emails to the server console (dev default).
#   Gmail:  EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_HOST_USER=you@gmail.com,
#           EMAIL_HOST_PASSWORD=<a Google "App Password", NOT your normal password>
#   Brevo:  EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587 (free tier ~300 emails/day)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=predatora186@gmail.com
EMAIL_HOST_PASSWORD=povciezxbutcziyl
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=predatora186@gmail.com

# Used to build links inside notification emails (e.g. "View student →").
FRONTEND_URL=https://your-frontend.onrender.com

# Shared secret for the free-scheduler cron trigger endpoints (see
# .github/workflows/notification-cron.yml). Generate any random string —
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
CRON_SECRET=
